<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows Phone 7 Recipes' Chapter1 SimpleXNAApplication (Fabio Claudio Ferracchiati and Emanuele Garofalo, Apress), the simplest XNA application, unchanged, hosted through CnaPhoneGame. Content built from its own content project by XNA's BuildContent (WindowsPhone/Reach). See ../../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <XnaPlatform>Windows Phone</XnaPlatform>
    <AssemblyName>SimpleXNAApplication</AssemblyName>
    <RootNamespace>SimpleXNAApplication</RootNamespace>
    <CnaPhoneGame>SimpleXNAApplication.Game1</CnaPhoneGame>
    <CnaPhoneCompat>true</CnaPhoneCompat>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CnaSampleDefineConstants>WINDOWS_PHONE</CnaSampleDefineConstants>
    <GameRoot>$(Wp7RecipesRoot)/Chapter1/SimpleXNAApplication/SimpleXNAApplication</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">/rv/tmp/xna-games-content/wp7r-simple/Content</GameContent>
    <GameProject>$(GameRoot)/SimpleXNAApplication.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
