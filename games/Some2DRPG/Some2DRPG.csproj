<Project Sdk="Microsoft.NET.Sdk">
  <!-- MichaelAquilina/Some-2D-RPG, an XNA 4.0 tile-based RPG with its own engine library, unchanged.
       Content built from its own content project by XNA's BuildContent (Windows/HiDef); its
       SpeechFont needs Lucida Console, a Windows font its repository does not ship. See ../README.md. -->
  <PropertyGroup>
    <XnaProfile>HiDef</XnaProfile>
    <AssemblyName>Some2DRPG</AssemblyName>
    <RootNamespace>Some2DRPG</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameRoot Condition="'$(GameRoot)' == ''">$(XnaGamesRoot)/Some-2D-RPG/Some2DRPG/Some2DRPG</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">$(XnaGamesContentRoot)/some2drpg/Content</GameContent>
    <GameProject>$(GameRoot)/Some2DRPG.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Engine/Engine.csproj" />
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
