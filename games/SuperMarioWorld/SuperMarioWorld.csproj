<Project Sdk="Microsoft.NET.Sdk">
  <!-- buttsj/c-sharp-mario ("Basic demo of Super Mario World in C#", a student team's Sprint 4),
       unchanged. Content built from its own content project by XNA's BuildContent (Windows/Reach);
       its eight MP3 songs are labelled stand-ins (song-standins option) played from the converted .ogg,
       and five documentation images its repository does not ship are listed, not built.
       See ../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <AssemblyName>Sprint_4</AssemblyName>
    <RootNamespace>Sprint_4</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameRoot Condition="'$(GameRoot)' == ''">$(XnaGamesRoot)/c-sharp-mario/Sprint 4/Sprint_4</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">$(XnaGamesContentRoot)/mario/Content</GameContent>
    <GameProject>$(GameRoot)/Sprint4.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
