<Project Sdk="Microsoft.NET.Sdk">
  <!-- alaskajohn/2dGPfG's "6-2-1-Foreground" (2D Graphics Programming for Games, XNA 4.0), unchanged, on the
       content its shared content project builds by XNA's BuildContent (Windows/Reach).
       See ../../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <AssemblyName>DepthExample1</AssemblyName>
    <RootNamespace>Foreground</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameRoot Condition="'$(GameRoot)' == ''">$(XnaGamesRoot)/alaskajohn_2dGPfG/2dGPfG-XNA/6-2-1-Foreground</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">$(XnaGamesContentRoot)/2dgpfg/Content</GameContent>
    <GameProject>$(GameRoot)/06-2-1-Foreground.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
