<Project Sdk="Microsoft.NET.Sdk">
  <!-- alaskajohn/2dGPfG's "5-3-1-SimpleTiles" (2D Graphics Programming for Games, XNA 4.0), unchanged, on the
       content its shared content project builds by XNA's BuildContent (Windows/Reach).
       See ../../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <AssemblyName>cameraSample1</AssemblyName>
    <RootNamespace>cameraSample1</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameRoot Condition="'$(GameRoot)' == ''">/rv/tmp/xna-games/alaskajohn_2dGPfG/2dGPfG-XNA/5-3-1-SimpleTiles</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">/rv/tmp/xna-games-content/2dgpfg/Content</GameContent>
    <GameProject>$(GameRoot)/05-3-1-SimpleTiles.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
