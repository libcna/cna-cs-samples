<Project Sdk="Microsoft.NET.Sdk">
  <!-- alaskajohn/2dGPfG's "10-2-0-SinusoidalBounce" (2D Graphics Programming for Games, XNA 4.0), unchanged, on the
       content its shared content project builds by XNA's BuildContent (Windows/Reach).
       See ../../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <AssemblyName>ColorSample</AssemblyName>
    <RootNamespace>ColorSample</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameRoot Condition="'$(GameRoot)' == ''">/rv/tmp/xna-games/alaskajohn_2dGPfG/2dGPfG-XNA/10-2-0-SinusoidalBounce</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">/rv/tmp/xna-games-content/2dgpfg/Content</GameContent>
    <GameProject>$(GameRoot)/10-2-0-SinusoidalBounce.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
