<Project Sdk="Microsoft.NET.Sdk">
  <!-- alaskajohn/2dGPfG's "3-1-7-MovingSprite" (2D Graphics Programming for Games, XNA 4.0), unchanged, on the
       content its shared content project builds by XNA's BuildContent (Windows/Reach).
       See ../../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <AssemblyName>ColorSample</AssemblyName>
    <RootNamespace>ColorSample</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameRoot Condition="'$(GameRoot)' == ''">$(XnaGamesRoot)/alaskajohn_2dGPfG/2dGPfG-XNA/3-1-7-MovingSprite</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">$(XnaGamesContentRoot)/2dgpfg/Content</GameContent>
    <GameProject>$(GameRoot)/03-1-7-MovingSprite.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
