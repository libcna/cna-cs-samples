<Project Sdk="Microsoft.NET.Sdk">
  <!-- alaskajohn/2dGPfG's "4-2-0-RunCylce" (2D Graphics Programming for Games, XNA 4.0), unchanged, on the
       content its shared content project builds by XNA's BuildContent (Windows/Reach).
       See ../../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <AssemblyName>animationSeq1</AssemblyName>
    <RootNamespace>animationSeq1</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameRoot Condition="'$(GameRoot)' == ''">$(XnaGamesRoot)/alaskajohn_2dGPfG/2dGPfG-XNA/4-2-0-RunCylce</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">$(XnaGamesContentRoot)/2dgpfg/Content</GameContent>
    <GameProject>$(GameRoot)/04-2-0-RunCylce.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
