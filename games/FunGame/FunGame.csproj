<Project Sdk="Microsoft.NET.Sdk">
  <!-- rpallarino3/Test2DGame's FunGame, unchanged. Content: the XNA build output its repository ships. See ../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <AssemblyName>FunGame</AssemblyName>
    <RootNamespace>FunGame</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameRoot Condition="'$(GameRoot)' == ''">$(XnaGamesRoot)/rpallarino3_Test2DGame/FunGame/FunGame/FunGame</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">$(GameRoot)/bin/x86/Debug/Content</GameContent>
    <GameProject>$(GameRoot)/FunGame.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
