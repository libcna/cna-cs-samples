<Project Sdk="Microsoft.NET.Sdk">
  <!-- dsplaisted/Disentanglement's portable solver library, unchanged, with the puzzle it embeds. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>PuzzleSolver</AssemblyName>
    <RootNamespace>PuzzleSolver</RootNamespace>
    <CnaSampleDefineConstants>TRACE</CnaSampleDefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameRoot Condition="'$(GameRoot)' == ''">$(XnaGamesRoot)/dsplaisted_Disentanglement/DisentanglementPortable</GameRoot>
    <GameProject>$(GameRoot)/DisentanglementPortable.csproj</GameProject>
  </PropertyGroup>
</Project>
