<Project Sdk="Microsoft.NET.Sdk">
  <!-- AlexMeuer/3D-Graphics-and-Audio's FlyingShip, a second-year course project, unchanged. Content built
       from its own content project by XNA's BuildContent (Windows/Reach). See ../../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <AssemblyName>XNA_3D_INTRO</AssemblyName>
    <RootNamespace>FlyingShip</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameRoot>$(AlexMeuer3DRoot)/FlyingShip/XNA_3D_INTRO</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">/rv/tmp/xna-games-content/alexmeuer-flyingship/Content</GameContent>
    <GameProject>$(GameRoot)/FlyingShip.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
