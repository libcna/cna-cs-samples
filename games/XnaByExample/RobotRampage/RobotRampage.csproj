<Project Sdk="Microsoft.NET.Sdk">
  <!-- XNA 4.0 Game Development by Example (Kurt Jaegers, Packt, 2010), as github.com/AcornPublishing/xna4-game ships its code: Robot Rampage, a twin-stick shooter, its final chapter's project, unchanged. Content built from its own content project by XNA's BuildContent (Windows/Reach). See ../../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <AssemblyName>Robot Rampage</AssemblyName>
    <RootNamespace>Robot_Rampage</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CnaSampleDefineConstants>WINDOWS</CnaSampleDefineConstants>
    <GameRoot>$(XnaByExampleRoot)/Chapter07/Code/Robot Rampage/Robot Rampage/Robot Rampage</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">/rv/tmp/xna-games-content/robotrampage/Content</GameContent>
    <GameProject>$(GameRoot)/Robot Rampage.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
