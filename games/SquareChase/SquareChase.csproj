<Project Sdk="Microsoft.NET.Sdk">
  <!-- nethojs29/SquareChase, the Square Chase game of XNA's tutorials, unchanged. Content: the XNA build output its repository ships. See ../README.md. -->
  <PropertyGroup>
    <XnaProfile>HiDef</XnaProfile>
    <AssemblyName>SuareChase</AssemblyName>
    <RootNamespace>SuareChase</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameRoot Condition="'$(GameRoot)' == ''">/rv/tmp/xna-games/nethojs29_SquareChase</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">$(GameRoot)/bin/x86/Debug/Content</GameContent>
    <GameProject>$(GameRoot)/SuareChase.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
