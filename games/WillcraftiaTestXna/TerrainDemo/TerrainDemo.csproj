<Project Sdk="Microsoft.NET.Sdk">
  <!-- willcraftia/TestXna's TerrainDemo, CDLOD terrain, unchanged. Content built from its own content project by XNA's BuildContent (Windows/HiDef). See ../../README.md. -->
  <PropertyGroup>
    <XnaProfile>HiDef</XnaProfile>
    <AssemblyName>TerrainDemo</AssemblyName>
    <RootNamespace>TerrainDemo</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CnaSampleDefineConstants>WINDOWS</CnaSampleDefineConstants>
    <GameRoot>$(TestXnaRoot)/TerrainDemo/TerrainDemo/TerrainDemo</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">$(XnaGamesContentRoot)/terraindemo/Content</GameContent>
    <GameProject>$(GameRoot)/TerrainDemo.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
