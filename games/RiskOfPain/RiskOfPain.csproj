<Project Sdk="Microsoft.NET.Sdk">
  <!-- nanexcool/RiskOfPain, unchanged. Content built from its own content project by XNA's BuildContent (Windows/Reach). See ../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <AssemblyName>RiskOfPain</AssemblyName>
    <RootNamespace>RiskOfPain</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameRoot Condition="'$(GameRoot)' == ''">/rv/tmp/xna-games/nanexcool_RiskOfPain/RiskOfPain/RiskOfPain</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">/rv/tmp/xna-games-content/riskofpain/Content</GameContent>
    <GameProject>$(GameRoot)/RiskOfPain.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
