<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows Phone 7 Game Development's Chapter4 Accelerometer (Adam Dawes, Apress), unchanged, hosted
       through CnaPhoneGame. Content built from its own content project by XNA's BuildContent
       (WindowsPhone/Reach). See ../../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <AssemblyName>Accelerometer</AssemblyName>
    <RootNamespace>Accelerometer</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CnaPhoneGame>AccelerometerDemo.AccelerometerGame</CnaPhoneGame>
    <CnaPhoneCompat>true</CnaPhoneCompat>
    <GameRoot>$(Wp7GameDevRoot)/Chapter4/Accelerometer/Accelerometer</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">/rv/tmp/xna-games-content/wp7gamedev/chapter4-accelerometer/Content</GameContent>
    <GameProject>$(GameRoot)/Accelerometer.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Chapter4-GameFramework/GameFramework.csproj" />
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
