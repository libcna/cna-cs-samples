<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows Phone 7 Game Development's Chapter4 CosmicRocksPartII (Adam Dawes, Apress), unchanged, hosted
       through CnaPhoneGame. Content built from its own content project by XNA's BuildContent
       (WindowsPhone/Reach). See ../../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <AssemblyName>CosmicRocksPartII</AssemblyName>
    <RootNamespace>CosmicRocksPartII</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CnaPhoneGame>CosmicRocksPartII.CosmicRocksPartIIGame</CnaPhoneGame>
    <GameRoot>$(Wp7GameDevRoot)/Chapter4/CosmicRocksPartII/CosmicRocksPartII</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">/rv/tmp/xna-games-content/wp7gamedev/chapter4-cosmicrockspartii/Content</GameContent>
    <GameProject>$(GameRoot)/CosmicRocksPartII.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Chapter4-GameFramework/GameFramework.csproj" />
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
