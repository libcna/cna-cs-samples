<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows Phone 7 Game Development's Chapter8 VaporTrail (Adam Dawes, Apress), unchanged, hosted
       through CnaPhoneGame. Content built from its own content project by XNA's BuildContent
       (WindowsPhone/Reach). See ../../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <AssemblyName>VaporTrail</AssemblyName>
    <RootNamespace>VaporTrail</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CnaPhoneGame>VaporTrail.VaporTrailGame</CnaPhoneGame>
    <GameRoot>$(Wp7GameDevRoot)/Chapter8/VaporTrail/VaporTrail</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">$(XnaGamesContentRoot)/wp7gamedev/chapter8-vaportrail/Content</GameContent>
    <GameProject>$(GameRoot)/VaporTrail.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Chapter8-GameFramework/GameFramework.csproj" />
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
