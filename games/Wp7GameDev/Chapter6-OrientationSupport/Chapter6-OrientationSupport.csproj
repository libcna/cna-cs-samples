<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows Phone 7 Game Development's Chapter6 OrientationSupport (Adam Dawes, Apress), unchanged, hosted
       through CnaPhoneGame. Content built from its own content project by XNA's BuildContent
       (WindowsPhone/Reach). See ../../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <AssemblyName>OrientationSupport</AssemblyName>
    <RootNamespace>OrientationSupport</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CnaPhoneGame>OrientationSupport.OrientationSupportGame</CnaPhoneGame>
    <GameRoot>$(Wp7GameDevRoot)/Chapter6/OrientationSupport/OrientationSupport</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">$(XnaGamesContentRoot)/wp7gamedev/chapter6-orientationsupport/Content</GameContent>
    <GameProject>$(GameRoot)/OrientationSupport.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>

    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
