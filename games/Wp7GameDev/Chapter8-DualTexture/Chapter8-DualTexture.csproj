<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows Phone 7 Game Development's Chapter8 DualTexture (Adam Dawes, Apress), unchanged, hosted
       through CnaPhoneGame. Content built from its own content project by XNA's BuildContent
       (WindowsPhone/Reach). See ../../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <AssemblyName>DualTexture</AssemblyName>
    <RootNamespace>DualTexture</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CnaPhoneGame>DualTexture.DualTextureGame</CnaPhoneGame>
    <GameRoot>$(Wp7GameDevRoot)/Chapter8/DualTexture/DualTexture</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">$(XnaGamesContentRoot)/wp7gamedev/chapter8-dualtexture/Content</GameContent>
    <GameProject>$(GameRoot)/DualTexture.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Chapter8-GameFramework/GameFramework.csproj" />
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
