<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows Phone 7 Game Development's Chapter5 SoundEffectInstances (Adam Dawes, Apress), unchanged, hosted
       through CnaPhoneGame. Content built from its own content project by XNA's BuildContent
       (WindowsPhone/Reach). See ../../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <AssemblyName>SoundEffectInstances</AssemblyName>
    <RootNamespace>SoundEffectInstances</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CnaPhoneGame>SoundEffectInstances.SoundEffectInstancesGame</CnaPhoneGame>
    <GameRoot>$(Wp7GameDevRoot)/Chapter5/SoundEffectInstances/SoundEffectInstances</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">/rv/tmp/xna-games-content/wp7gamedev/chapter5-soundeffectinstances/Content</GameContent>
    <GameProject>$(GameRoot)/SoundEffectInstances.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Chapter5-GameFramework/GameFramework.csproj" />
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
