<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows Phone 7 Game Development's Chapter10 VaporTrailTS (Adam Dawes, Apress), unchanged, hosted
       through CnaPhoneGame. Content built from its own content project by XNA's BuildContent
       (WindowsPhone/Reach). See ../../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <AssemblyName>VaporTrailTS</AssemblyName>
    <RootNamespace>VaporTrailTS</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CnaPhoneGame>VaporTrailTS.VaporTrailTSGame</CnaPhoneGame>
    <CnaPhoneCompat>true</CnaPhoneCompat>
    <GameRoot>$(Wp7GameDevRoot)/Chapter10/VaporTrailTS/VaporTrailTS</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">/rv/tmp/xna-games-content/wp7gamedev/chapter10-vaportrailts/Content</GameContent>
    <GameProject>$(GameRoot)/VaporTrailTS.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Chapter10-GameFramework/GameFramework.csproj" />
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
