<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows Phone 7 Game Development's Chapter3 CosmicRocksPartI (Adam Dawes, Apress), unchanged, hosted
       through CnaPhoneGame. Content built from its own content project by XNA's BuildContent
       (WindowsPhone/Reach). See ../../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <AssemblyName>CosmicRocksPartI</AssemblyName>
    <RootNamespace>CosmicRocksPartI</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CnaPhoneGame>CosmicRocksPartI.CosmicRocksPartIGame</CnaPhoneGame>
    <GameRoot>$(Wp7GameDevRoot)/Chapter3/CosmicRocksPartI/CosmicRocksPartI</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">/rv/tmp/xna-games-content/wp7gamedev/chapter3-cosmicrocksparti/Content</GameContent>
    <GameProject>$(GameRoot)/CosmicRocksPartI.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Chapter3-GameFramework/GameFramework.csproj" />
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
