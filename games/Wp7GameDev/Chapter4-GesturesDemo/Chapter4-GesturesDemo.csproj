<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows Phone 7 Game Development's Chapter4 GesturesDemo (Adam Dawes, Apress), unchanged, hosted
       through CnaPhoneGame. Content built from its own content project by XNA's BuildContent
       (WindowsPhone/Reach). See ../../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <AssemblyName>GesturesDemo</AssemblyName>
    <RootNamespace>GesturesDemo</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CnaPhoneGame>GesturesDemo.GesturesDemoGame</CnaPhoneGame>
    <CnaPhoneCompat>true</CnaPhoneCompat>
    <GameRoot>$(Wp7GameDevRoot)/Chapter4/GesturesDemo/GesturesDemo</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">$(XnaGamesContentRoot)/wp7gamedev/chapter4-gesturesdemo/Content</GameContent>
    <GameProject>$(GameRoot)/GesturesDemo.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Chapter4-GameFramework/GameFramework.csproj" />
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
