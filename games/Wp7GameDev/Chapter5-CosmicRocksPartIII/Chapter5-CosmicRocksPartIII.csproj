<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows Phone 7 Game Development's Chapter5 CosmicRocksPartIII (Adam Dawes, Apress), unchanged, hosted
       through CnaPhoneGame. Content built from its own content project by XNA's BuildContent
       (WindowsPhone/Reach). See ../../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <AssemblyName>CosmicRocksPartIII</AssemblyName>
    <RootNamespace>CosmicRocksPartIII</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CnaPhoneGame>CosmicRocksPartIII.CosmicRocksPartIIIGame</CnaPhoneGame>
    <GameRoot>$(Wp7GameDevRoot)/Chapter5/CosmicRocksPartIII/CosmicRocksPartIII</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">$(XnaGamesContentRoot)/wp7gamedev/chapter5-cosmicrockspartiii/Content</GameContent>
    <GameProject>$(GameRoot)/CosmicRocksPartIII.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Chapter5-GameFramework/GameFramework.csproj" />
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
