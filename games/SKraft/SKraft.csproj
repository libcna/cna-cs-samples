<Project Sdk="Microsoft.NET.Sdk">
  <!-- Kermit/SKraft, a student block-world game on XNA 4.0, unchanged. Content built from its own
       content project, with its own SKraftPipeline model processor, by XNA's BuildContent
       (Windows/Reach). See ../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <AssemblyName>SKraft</AssemblyName>
    <RootNamespace>SKraft</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameRoot Condition="'$(GameRoot)' == ''">/rv/tmp/xna-games/SKraft/SKraft/SKraft</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">/rv/tmp/xna-games-content/skraft/Content</GameContent>
    <GameProject>$(GameRoot)/SKraft.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
