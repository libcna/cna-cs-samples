<Project Sdk="Microsoft.NET.Sdk">
  <!-- imeteora/BoneAnimation's XNA example, a skeletal sprite animation, unchanged, on the Bones.XNA library it ships. Content built from its own content project by XNA's BuildContent (Windows/Reach); its hero.png and hero.skt copied beside it as its project copies them. See ../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <AssemblyName>BoneTestGame</AssemblyName>
    <RootNamespace>BoneTestGame</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CnaSampleDefineConstants>WINDOWS</CnaSampleDefineConstants>
    <GameRoot Condition="'$(GameRoot)' == ''">$(XnaGamesRoot)/imeteora_BoneAnimation/Bones.XNA.Example/BoneTestGame</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">$(XnaGamesContentRoot)/bones/Content</GameContent>
    <GameProject>$(GameRoot)/Bones.XNA.Example.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="BoneLibrary/BoneLibrary.csproj" />
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
