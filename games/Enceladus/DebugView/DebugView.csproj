<Project Sdk="Microsoft.NET.Sdk">
  <!-- Farseer's DebugView XNA, as zachmu/escape-from-enceladus redistributes it, unchanged. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <XnaProfile>Reach</XnaProfile>
    <AssemblyName>DebugViewXNA</AssemblyName>
    <RootNamespace>FarseerPhysics.DebugViews</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameRoot Condition="'$(GameRoot)' == ''">$(XnaGamesRoot)/escape-from-enceladus</GameRoot>
    <GameProject>$(GameRoot)/Farseer Physics Engine 3.3.1 Samples XNA/DebugView XNA/DebugView XNA.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FarseerPhysics/FarseerPhysics.csproj" />
  </ItemGroup>
</Project>
