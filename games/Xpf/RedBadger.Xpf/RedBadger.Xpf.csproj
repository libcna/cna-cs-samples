<Project Sdk="Microsoft.NET.Sdk">
  <!-- Red Badger's XPF core, unchanged, with the Rx 2.0 assemblies its repository's packages folder
       ships. Compiled with its Release configuration's symbols (TRACE). -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>RedBadger.Xpf</AssemblyName>
    <RootNamespace>RedBadger.Xpf</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CnaSampleDefineConstants>TRACE</CnaSampleDefineConstants>
    <GameRoot>$(XpfRoot)/XPF/RedBadger.Xpf</GameRoot>
    <GameProject>$(GameRoot)/RedBadger.Xpf.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Reactive.Core" HintPath="$(XpfPackages)/Rx-Core.2.0.20823/lib/Net40/System.Reactive.Core.dll" />
    <Reference Include="System.Reactive.Interfaces" HintPath="$(XpfPackages)/Rx-Interfaces.2.0.20823/lib/Net40/System.Reactive.Interfaces.dll" />
    <Reference Include="System.Reactive.Linq" HintPath="$(XpfPackages)/Rx-Linq.2.0.20823/lib/Net40/System.Reactive.Linq.dll" />
    <Reference Include="System.Reactive.PlatformServices" HintPath="$(XpfPackages)/Rx-PlatformServices.2.0.20823/lib/Net40/System.Reactive.PlatformServices.dll" />
  </ItemGroup>
</Project>
