<Project Sdk="Microsoft.NET.Sdk">
  <!-- debreuil/MyBigHeadIsWeighingMeDownGame, unchanged, on debreuil/Swf2XNA's runtime (../Swf2Xna).
       Content built from its own content project with Swf2XNA's pipeline extension by XNA's
       BuildContent (scripts/build-xna-content.sh). See ../README.md. -->
  <PropertyGroup>
    <XnaProfile>HiDef</XnaProfile>
    <AssemblyName>HeadGame</AssemblyName>
    <RootNamespace>HeadGame</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameRoot Condition="'$(GameRoot)' == ''">$(XnaGamesRoot)/MyBigHeadIsWeighingMeDownGame/HeadGame</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">$(XnaGamesContentRoot)/headgame/Content</GameContent>
    <GameProject>$(GameRoot)/HeadGame.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Swf2Xna/Box2D.XNA/Box2D.XNA.csproj" />
    <ProjectReference Include="../Swf2Xna/V2DRuntime/V2DRuntime.csproj" />
    <ProjectReference Include="../Swf2Xna/VexPipelineReader/VexPipelineReader.csproj" />
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
