<Project Sdk="Microsoft.NET.Sdk">
  <!-- Zero-One101/Mario3, a Super Mario Bros. 3 clone, unchanged. Content built from its own content project by XNA's BuildContent (Windows/Reach). See ../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <AssemblyName>Mario3</AssemblyName>
    <RootNamespace>Mario3</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameRoot Condition="'$(GameRoot)' == ''">$(XnaGamesRoot)/Zero-One101_Mario3/Mario3/Mario3</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">$(XnaGamesContentRoot)/mario3/Content</GameContent>
    <GameProject>$(GameRoot)/Mario3.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
