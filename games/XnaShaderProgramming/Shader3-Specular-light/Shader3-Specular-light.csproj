<Project Sdk="Microsoft.NET.Sdk">
  <!-- petriw/XNA-Shader-Programming's "XNA4ShaderProgramming 3 - Specular light" (XNA 4.0), unchanged. Content built from its own
       content project by XNA's BuildContent (Windows/Reach). See ../../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <AssemblyName>XNAShaderProgramming</AssemblyName>
    <RootNamespace>XNAShaderProgramming</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameRoot Condition="'$(GameRoot)' == ''">$(XnaGamesRoot)/petriw_XNA-Shader-Programming/XNA4ShaderProgramming 3 - Specular light/XNAShaderProgramming/XNAShaderProgramming</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">$(XnaGamesContentRoot)/petriw/3-Specular-light/Content</GameContent>
    <GameProject>$(GameRoot)/XNAShaderProgramming.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
