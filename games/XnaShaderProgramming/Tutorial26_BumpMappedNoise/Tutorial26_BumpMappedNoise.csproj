<Project Sdk="Microsoft.NET.Sdk">
  <!-- petriw/XNA-Shader-Programming's "Tutorial26_BumpMappedNoise" (XNA 4.0), unchanged. Content built from its own
       content project by XNA's BuildContent (Windows/HiDef). See ../../README.md. -->
  <PropertyGroup>
    <XnaProfile>HiDef</XnaProfile>
    <AssemblyName>NoiseGPU</AssemblyName>
    <RootNamespace>NoiseGPU</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameRoot Condition="'$(GameRoot)' == ''">$(XnaGamesRoot)/petriw_XNA-Shader-Programming/Tutorial26_BumpMappedNoise/NoiseGPU/NoiseGPU</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">$(XnaGamesContentRoot)/petriw/Tutorial26_BumpMappedNoise/Content</GameContent>
    <GameProject>$(GameRoot)/BumpMapNoise.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
