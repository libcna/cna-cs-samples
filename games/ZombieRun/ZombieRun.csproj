<Project Sdk="Microsoft.NET.Sdk">
  <!-- scottrehlander/ZombieRunXNA's FrunWithXNA2, unchanged: its Windows copy of the phone project,
       the one with rockets and flying seekers. Content: the XNA build output its repository ships
       (bin/x86/Debug/Content). See ../README.md. -->
  <PropertyGroup>
    <XnaProfile>HiDef</XnaProfile>
    <AssemblyName>FrunWithXNA2</AssemblyName>
    <RootNamespace>FrunWithXNA2</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameRoot Condition="'$(GameRoot)' == ''">$(XnaGamesRoot)/scottrehlander_ZombieRunXNA/FrunWithXNA2/FrunWithXNA2</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">$(GameRoot)/bin/x86/Debug/Content</GameContent>
    <GameProject>$(GameRoot)/Windows Copy of Windows Phone FrunWithXNA2.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
