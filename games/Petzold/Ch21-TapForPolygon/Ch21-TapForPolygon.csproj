<Project Sdk="Microsoft.NET.Sdk">
  <!-- Programming Windows Phone 7's Chapter 21 TapForPolygon (Charles Petzold, Microsoft Press, 2010), unchanged, hosted through CnaPhoneGame. Content built from its own content project by XNA's BuildContent (WindowsPhone/Reach). See ../../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <XnaPlatform>Windows Phone</XnaPlatform>
    <AssemblyName>TapForPolygon</AssemblyName>
    <RootNamespace>TapForPolygon</RootNamespace>
    <CnaPhoneGame>TapForPolygon.Game1</CnaPhoneGame>
    <CnaPhoneCompat>true</CnaPhoneCompat>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CnaSampleDefineConstants>WINDOWS_PHONE</CnaSampleDefineConstants>
    <GameRoot>$(PetzoldRoot)/Chapter 21/TapForPolygon/TapForPolygon/TapForPolygon</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">/rv/tmp/xna-games-content/petzold/petzold-ch21-tapforpolygon/Content</GameContent>
    <GameProject>$(GameRoot)/TapForPolygon.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Petzold.Phone.Xna/Petzold.Phone.Xna.csproj" />
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
