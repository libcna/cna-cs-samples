<Project Sdk="Microsoft.NET.Sdk">
  <!-- Programming Windows Phone 7's Chapter 19 TextCrawl (Charles Petzold, Microsoft Press, 2010), unchanged, hosted through CnaPhoneGame. Content built from its own content project by XNA's BuildContent (WindowsPhone/Reach). See ../../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <XnaPlatform>Windows Phone</XnaPlatform>
    <AssemblyName>TextCrawl</AssemblyName>
    <RootNamespace>TextCrawl</RootNamespace>
    <CnaPhoneGame>TextCrawl.Game1</CnaPhoneGame>
    <CnaPhoneCompat>true</CnaPhoneCompat>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CnaSampleDefineConstants>WINDOWS_PHONE</CnaSampleDefineConstants>
    <GameRoot>$(PetzoldRoot)/Chapter 19/TextCrawl/TextCrawl/TextCrawl</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">$(XnaGamesContentRoot)/petzold/petzold-ch19-textcrawl/Content</GameContent>
    <GameProject>$(GameRoot)/TextCrawl.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>

    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
