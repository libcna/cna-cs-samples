<Project Sdk="Microsoft.NET.Sdk">
  <!-- Programming Windows Phone 7's Chapter 21 GradientBackground (Charles Petzold, Microsoft Press, 2010), unchanged, hosted through CnaPhoneGame. Content built from its own content project by XNA's BuildContent (WindowsPhone/Reach). See ../../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <XnaPlatform>Windows Phone</XnaPlatform>
    <AssemblyName>GradientBackground</AssemblyName>
    <RootNamespace>GradientBackground</RootNamespace>
    <CnaPhoneGame>GradientBackground.Game1</CnaPhoneGame>
    <CnaPhoneCompat>true</CnaPhoneCompat>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CnaSampleDefineConstants>WINDOWS_PHONE</CnaSampleDefineConstants>
    <GameRoot>$(PetzoldRoot)/Chapter 21/GradientBackground/GradientBackground/GradientBackground</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">/rv/tmp/xna-games-content/petzold/petzold-ch21-gradientbackground/Content</GameContent>
    <GameProject>$(GameRoot)/GradientBackground.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>

    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
