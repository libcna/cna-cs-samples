<Project Sdk="Microsoft.NET.Sdk">
  <!-- Programming Windows Phone 7's Chapter 21 PinwheelText (Charles Petzold, Microsoft Press, 2010), unchanged, hosted through CnaPhoneGame. Content built from its own content project by XNA's BuildContent (WindowsPhone/Reach). See ../../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <XnaPlatform>Windows Phone</XnaPlatform>
    <AssemblyName>PinwheelText</AssemblyName>
    <RootNamespace>PinwheelText</RootNamespace>
    <CnaPhoneGame>PinwheelText.Game1</CnaPhoneGame>
    <CnaPhoneCompat>true</CnaPhoneCompat>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CnaSampleDefineConstants>WINDOWS_PHONE</CnaSampleDefineConstants>
    <GameRoot>$(PetzoldRoot)/Chapter 21/PinwheelText/PinwheelText/PinwheelText</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">$(XnaGamesContentRoot)/petzold/petzold-ch21-pinwheeltext/Content</GameContent>
    <GameProject>$(GameRoot)/PinwheelText.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>

    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
