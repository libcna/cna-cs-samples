<Project Sdk="Microsoft.NET.Sdk">
  <!-- Programming Windows Phone 7's Chapter 19 ParametricTextMovement (Charles Petzold, Microsoft Press, 2010), unchanged, hosted through CnaPhoneGame. Content built from its own content project by XNA's BuildContent (WindowsPhone/Reach). See ../../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <XnaPlatform>Windows Phone</XnaPlatform>
    <AssemblyName>ParametricTextMovement</AssemblyName>
    <RootNamespace>ParametricTextMovement</RootNamespace>
    <CnaPhoneGame>ParametricTextMovement.Game1</CnaPhoneGame>
    <CnaPhoneCompat>true</CnaPhoneCompat>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CnaSampleDefineConstants>WINDOWS_PHONE</CnaSampleDefineConstants>
    <GameRoot>$(PetzoldRoot)/Chapter 19/ParametricTextMovement/ParametricTextMovement/ParametricTextMovement</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">/rv/tmp/xna-games-content/petzold/petzold-ch19-parametrictextmovement/Content</GameContent>
    <GameProject>$(GameRoot)/ParametricTextMovement.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>

    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
