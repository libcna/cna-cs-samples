<Project Sdk="Microsoft.NET.Sdk">
  <!-- Programming Windows Phone 7's Chapter 04 XnaWebBitmap (Charles Petzold, Microsoft Press, 2010), unchanged, hosted through CnaPhoneGame. Content built from its own content project by XNA's BuildContent (WindowsPhone/Reach). See ../../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <XnaPlatform>Windows Phone</XnaPlatform>
    <AssemblyName>XnaWebBitmap</AssemblyName>
    <RootNamespace>XnaWebBitmap</RootNamespace>
    <CnaPhoneGame>XnaWebBitmap.Game1</CnaPhoneGame>
    <CnaPhoneCompat>true</CnaPhoneCompat>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CnaSampleDefineConstants>WINDOWS_PHONE</CnaSampleDefineConstants>
    <GameRoot>$(PetzoldRoot)/Chapter 04/XnaWebBitmap/XnaWebBitmap/XnaWebBitmap</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">/rv/tmp/xna-games-content/petzold/petzold-ch04-xnawebbitmap/Content</GameContent>
    <GameProject>$(GameRoot)/XnaWebBitmap.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>

    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
