<Project Sdk="Microsoft.NET.Sdk">
  <!-- mtio/GoingToTheStars' "Shootin", a gravity shooter, unchanged. Content: the XNA build output
       its repository ships (bin/x86/Debug/Content). See ../README.md. -->
  <PropertyGroup>
    <XnaProfile>Reach</XnaProfile>
    <AssemblyName>Shootin</AssemblyName>
    <RootNamespace>Shootin</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameRoot Condition="'$(GameRoot)' == ''">/rv/tmp/xna-games/mtio_GoingToTheStars/Shootin/Shootin/Shootin</GameRoot>
    <GameContent Condition="'$(GameContent)' == ''">$(GameRoot)/bin/x86/Debug/Content</GameContent>
    <GameProject>$(GameRoot)/Shootin.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(GameContent)/**/*" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
