<Project Sdk="Microsoft.NET.Sdk">
  <!-- Farseer Physics DebugView 3.5 as laie/RescueTheVisualStudio ships it, unchanged. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <XnaProfile>Reach</XnaProfile>
    <AssemblyName>DebugView XNA</AssemblyName>
    <RootNamespace>FarseerPhysics.DebugView</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CnaSampleDefineConstants>WINDOWS</CnaSampleDefineConstants>
    <GameRoot Condition="'$(GameRoot)' == ''">$(XnaGamesRoot)/laie_RescueTheVisualStudio/FarseerPhysics_3_5/Farseer Physics DebugView 3.5</GameRoot>
    <GameProject>$(GameRoot)/DebugView XNA.csproj</GameProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Farseer/Farseer.csproj" />
  </ItemGroup>
</Project>
