<Project Sdk="Microsoft.NET.Sdk">
  <!-- XNA Game Studio 4.0 sample: Pathfinding_4_0, Windows configuration. Two upstream source
       trees live side by side here, so default compile items are off in both projects. -->
  <PropertyGroup>
    <!-- The original project's graphics profile; CNA.XnaCompat.targets embeds it as XNA did. -->
    <XnaProfile>HiDef</XnaProfile>
    <RootNamespace>Pathfinding</RootNamespace>
    <AssemblyName>Pathfinding</AssemblyName>
    <StartupObject>Pathfinding.Program</StartupObject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Pathfinding/**/*.cs" />
    <ProjectReference Include="MapData.csproj" />
  </ItemGroup>
</Project>
