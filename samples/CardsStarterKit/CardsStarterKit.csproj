<Project Sdk="Microsoft.NET.Sdk">
  <!-- Two upstream source trees live side by side here, so default compile items are off. -->
  <PropertyGroup>
    <!-- The original project's graphics profile; CNA.XnaCompat.targets embeds it as XNA did. -->
    <XnaProfile>HiDef</XnaProfile>
    <RootNamespace>Blackjack</RootNamespace>
    <AssemblyName>Blackjack</AssemblyName>
    <StartupObject>Blackjack.Program</StartupObject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="CardsGame/**/*.cs" />
    <ProjectReference Include="CardsFramework.csproj" />
  </ItemGroup>
</Project>
