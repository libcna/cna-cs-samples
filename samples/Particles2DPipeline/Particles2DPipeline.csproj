<Project Sdk="Microsoft.NET.Sdk">
  <!-- Two upstream source trees live side by side here, so default compile items are off. -->
  <PropertyGroup>
    <!-- The original project's graphics profile; CNA.XnaCompat.targets embeds it as XNA did. -->
    <XnaProfile>HiDef</XnaProfile>
    <RootNamespace>Particles2DPipelineSample</RootNamespace>
    <AssemblyName>Particles2DPipelineSample</AssemblyName>
    <StartupObject>Particles2DPipelineSample.Program</StartupObject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Particles2DPipelineSample/**/*.cs" />
    <ProjectReference Include="ParticleSettings.csproj" />
  </ItemGroup>
</Project>
