<Project Sdk="Microsoft.NET.Sdk">
  <!-- Two upstream source trees live side by side here, so default compile items are off. -->
  <PropertyGroup>
    <!-- The original project's graphics profile; CNA.XnaCompat.targets embeds it as XNA did. -->
    <XnaProfile>Reach</XnaProfile>
    <RootNamespace>CpuSkinningDemo</RootNamespace>
    <AssemblyName>CpuSkinningDemo</AssemblyName>
    <StartupObject>CpuSkinningDemo.CpuSkinningDemoGame</StartupObject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="CpuSkinningDemo/**/*.cs" />
    <ProjectReference Include="CpuSkinningDataTypes.csproj" />
  </ItemGroup>
</Project>
