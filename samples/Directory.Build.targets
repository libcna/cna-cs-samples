<Project>

  <!--
    This file exists because `Directory.Build.props` cannot do this. Props is imported BEFORE the
    SDK's default item globs run, so an `Update` there has no items to update and is silently a
    no-op. Targets is imported after the project body, by which time the `EmbeddedResource` items
    exist. That distinction cost a debugging round: the rule looked right, changed nothing, and the
    samples failed exactly as before.

    Every sample's .resx sat at the ROOT of its upstream project, so XNA embedded it as
    `<RootNamespace>.<Filename>.resources`. Here the upstream tree is checked in one directory
    down, and the SDK derives a resource's manifest name from RootNamespace plus its path, which
    inserts an extra segment. The generated Designer class then asks for a name that is not there:

      Could not find the resource "InputReporter.InputReporterResources.resources" among the
      resources "InputReporter.InputReporter.InputReporterResources.resources"

    Restating LogicalName restores what upstream produced, and the rule is exact rather than a
    guess: %(Filename) keeps the culture suffix, so `Strings.da.resx` becomes
    `<RootNamespace>.Strings.da.resources` and the SDK still builds its satellite assembly.

    This is a consequence of THIS repository's layout, not a difference in any sample, which is why
    it lives here rather than in each project. CSSAMPLE-078 and CSSAMPLE-009 both hit it.
  -->
  <!--
    XNA's build wrote the project's <XnaProfile> into the game assembly, and GraphicsDeviceManager
    reads it for its default GraphicsProfile. A package consumer gets this from CNA.XnaCompat's
    build/ folder; these samples reference the project, so they import it here, and each sample
    states its original project's profile.
  -->
  <Import Project="$(CnaCsRoot)/src/CNA.XnaCompat/build/CNA.XnaCompat.targets"
          Condition="'$(CnaCsRoot)' != '' and Exists('$(CnaCsRoot)/src/CNA.XnaCompat/build/CNA.XnaCompat.targets')" />

  <ItemGroup>
    <EmbeddedResource Update="**/*.resx">
      <LogicalName>$(RootNamespace).%(Filename).resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    A Windows Phone game has no entry point of its own: the XAP host constructed its Game subclass.
    A phone-only sample names that class in <CnaPhoneGame>, and the build generates the stand-in
    host into obj/ as project glue, so nothing is authored into the upstream tree. <CnaPhoneCompat>
    references CNA.PhoneCompat, the opt-in assembly carrying the Windows Phone device APIs.
  -->
  <!--
    The DefineConstants of the configuration the row builds: the original Windows one, or the
    phone one (TRACE;WINDOWS_PHONE) for a phone-only sample hosted below. A sample whose selected
    configuration differs sets CnaSampleDefineConstants in its own .csproj. This is here rather than
    in Directory.Build.props because props are read before the project body, so an override there
    never arrived.
  -->
  <PropertyGroup>
    <CnaSampleDefineConstants Condition="'$(CnaSampleDefineConstants)' == '' and '$(CnaPhoneGame)' != ''">WINDOWS_PHONE</CnaSampleDefineConstants>
    <CnaSampleDefineConstants Condition="'$(CnaSampleDefineConstants)' == ''">WINDOWS</CnaSampleDefineConstants>
    <DefineConstants>$(DefineConstants);$(CnaSampleDefineConstants)</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CnaPhoneGame)' != ''">
    <StartupObject>CnaPhoneHost</StartupObject>
    <CnaPhoneHostFile>$(IntermediateOutputPath)CnaPhoneHost.g.cs</CnaPhoneHostFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(CnaPhoneCompat)' == 'true' and '$(CnaCsRoot)' != ''">
    <ProjectReference Include="$(CnaCsRoot)/src/CNA.PhoneCompat/CNA.PhoneCompat.csproj" />
  </ItemGroup>

  <Target Name="GenerateCnaPhoneHost" BeforeTargets="CoreCompile" Condition="'$(CnaPhoneGame)' != ''">
    <WriteLinesToFile File="$(CnaPhoneHostFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// Generated by samples/Directory.Build.targets from CnaPhoneGame: the XAP host's stand-in.;static class CnaPhoneHost { static void Main() { using (var game = new global::$(CnaPhoneGame)()) { game.Run()%3B } } }" />
    <ItemGroup>
      <Compile Include="$(CnaPhoneHostFile)" />
      <FileWrites Include="$(CnaPhoneHostFile)" />
    </ItemGroup>
  </Target>

</Project>
