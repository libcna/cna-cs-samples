<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The original project's graphics profile; CNA.XnaCompat.targets embeds it as XNA did. -->
    <XnaProfile>Reach</XnaProfile>
    <XnaPlatform>Windows Phone</XnaPlatform>
    <RootNamespace>RimLighting</RootNamespace>
    <AssemblyName>RimLighting</AssemblyName>
    <!-- Upstream ships only the phone project: TRACE;WINDOWS_PHONE, so its Main is guarded out
         (and names a Game1 that does not exist; the class is SampleGame). -->
    <CnaPhoneGame>RimLighting.SampleGame</CnaPhoneGame>
    <CnaPhoneCompat>true</CnaPhoneCompat>
  </PropertyGroup>
</Project>
