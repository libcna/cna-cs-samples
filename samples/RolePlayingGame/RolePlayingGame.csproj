<Project Sdk="Microsoft.NET.Sdk">
  <!-- Two upstream source trees live side by side here, so default compile items are off. -->
  <PropertyGroup>
    <!-- The original project's graphics profile; CNA.XnaCompat.targets embeds it as XNA did. -->
    <XnaProfile>HiDef</XnaProfile>
    <RootNamespace>RolePlaying</RootNamespace>
    <AssemblyName>RolePlayingGame</AssemblyName>
    <StartupObject>RolePlaying.RolePlayingGame</StartupObject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="RolePlayingGame/**/*.cs" />
    <ProjectReference Include="RolePlayingGameData.csproj" />
  </ItemGroup>
</Project>
