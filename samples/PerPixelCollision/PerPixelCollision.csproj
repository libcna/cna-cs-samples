<Project Sdk="Microsoft.NET.Sdk">

  <!--
    XNA Game Studio 4.0 sample: PerPixelCollisionSample_4_0
    Selected configuration: PerPixelCollision/PerPixelCollisionWindows.csproj, Release|x86
    (Windows, Reach). Main is in a static Program class in Program.cs.
  -->
  <PropertyGroup>
    <!-- The original project's graphics profile; CNA.XnaCompat.targets embeds it as XNA did. -->
    <XnaProfile>Reach</XnaProfile>
    <RootNamespace>PerPixelCollision</RootNamespace>
    <AssemblyName>PerPixelCollision</AssemblyName>
    <StartupObject>PerPixelCollision.Program</StartupObject>
  </PropertyGroup>

</Project>
