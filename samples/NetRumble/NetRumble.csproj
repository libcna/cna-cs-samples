<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The original project's graphics profile; CNA.XnaCompat.targets embeds it as XNA did. -->
    <XnaProfile>HiDef</XnaProfile>
    <RootNamespace>NetRumble</RootNamespace>
    <AssemblyName>NetRumble</AssemblyName>
    <!-- Program is nested in the game class. -->
    <StartupObject>NetRumble.NetRumbleGame.Program</StartupObject>
  </PropertyGroup>

  <!--
    NetRumbleGame enumerates its sound effects with the BCL, not with XNA:
      new DirectoryInfo(Content.RootDirectory + @"\audio\wav")
    which Windows resolves to Content/Audio/wav, and no other file system does. The sounds themselves
    still load through XNA's ContentManager.
  -->
  <ItemGroup>
    <CnaWindowsPath Include="audio" Path="Content%5Caudio%5Cwav" LinksTo="Content/Audio/wav" />
  </ItemGroup>
</Project>
