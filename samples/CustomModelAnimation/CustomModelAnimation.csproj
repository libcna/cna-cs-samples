<Project Sdk="Microsoft.NET.Sdk">
  <!-- Two upstream source trees live side by side here, so default compile items are off. -->
  <PropertyGroup>
    <!-- The original project's graphics profile; CNA.XnaCompat.targets embeds it as XNA did. -->
    <XnaProfile>HiDef</XnaProfile>
    <RootNamespace>CustomModelAnimationSample</RootNamespace>
    <AssemblyName>CustomModelAnimationSample</AssemblyName>
    <StartupObject>CustomAvatarAnimationSample.CustomAvatarAnimationSampleGame</StartupObject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="CustomModelAnimationSample/**/*.cs" />
    <ProjectReference Include="CustomModelAnimationWindows.csproj" />
  </ItemGroup>
</Project>
